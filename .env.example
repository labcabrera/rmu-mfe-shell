# Local development against the rmu-platform stack.
#
#   cd ../rmu-platform && make up            # infrastructure, apis, mfes and gateway
#   make mfe-dev s=shell                     # stops the rmu-mfe-shell container
#   cp .env.example .env && make start       # or F5 in VS Code ("Debug shell")
#
# Open http://localhost (the gateway), not :8080: the gateway sends / to this dev server while
# the container is stopped, and /mfe/<name>/ and /api/<name>/ to the other containers.
#
# webpack loads `.env.<mode>` first (for example `.env.development`) and falls back to this `.env`.
# The values below are not baked into the bundle: the dev server serves them as /env-config.js
# (keys listed in public/env-config.template.js). The Docker image takes them from its environment.

# Shell dev server
PORT=8080

# Keycloak (rmu-platform compose) and the public PKCE client created by rmu-platform/terraform.
KC_URL=http://localhost:8090
KC_REALM=rmu
KC_CLIENT_ID=rmu-client-front

# Static assets: images and locales served by rmu-mfe-assets (`python3 local-start.py`).
RMU_MFE_ASSETS=http://localhost:4000/
# Base URL for i18n locales. Defaults to RMU_MFE_ASSETS.
# RMU_MFE_I18N_BASE_URL=http://localhost:4000/

# Remote micro-frontends behind the gateway. The trailing slash is required: the shell appends
# `<name>-app.js`. The gateway serves each one from its container, or from its dev server when
# the container is stopped.
RMU_MFE_CORE_PUBLIC_PATH=/mfe/core/
RMU_MFE_STRATEGIC_PUBLIC_PATH=/mfe/strategic/
RMU_MFE_TACTICAL_PUBLIC_PATH=/mfe/tactical/
RMU_MFE_NPCS_PUBLIC_PATH=/mfe/npcs/
RMU_MFE_ITEMS_PUBLIC_PATH=/mfe/items/
RMU_MFE_SPELLS_PUBLIC_PATH=/mfe/spells/

# APIs behind the gateway (/api/<name>/). The remotes read these from the shell's configuration.
RMU_API_CORE_URL=/api/core/v1
RMU_API_STRATEGIC_URL=/api/strategic/v1
RMU_API_TACTICAL_URL=/api/tactical/v1
RMU_API_ITEMS_URL=/api/items/v1
RMU_API_ATTACK_TABLES_URL=/api/attack-tables/v1
RMU_API_NPC_NAMES_URL=/api/npc-names/v1
RMU_API_NPCS_URL=/api/npcs/v1
RMU_API_SPELLS_URL=/api/spells/v1
RMU_API_USERS_URL=/api/users/v1
RMU_API_MEDIA_URL=/api/media/v1

# Contact page (optional).
# REACT_APP_CONTACT_API=
# REACT_APP_CONTACT_EMAIL=
