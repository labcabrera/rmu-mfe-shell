# rmu-mfe-shell: local development against the rmu-platform stack.
#
#   cd ../rmu-platform && make up            # infrastructure, apis, mfes and gateway
#   make mfe-dev s=shell                     # stops the rmu-mfe-shell container
#   cp .env.example .env && make start       # or F5 in VS Code ("Debug shell (gateway)")
#
# Open http://localhost (the gateway), not :8080: the gateway sends / to this dev server while
# the container is stopped, and /mfe/<name>/ and /api/<name>/ to the other containers.
#
# webpack loads `.env.<mode>` first (for example `.env.development`) and falls back to this `.env`.
# The RMU_* values are not baked into the bundle: the dev server serves them as /env-config.js
# (keys listed in public/env-config.template.js). The Docker image takes them from its environment.
# The remotes read this same configuration, so it also carries the URLs they use.

# --- Dev server --------------------------------------------------------------------------------
PORT=8080

# --- Keycloak ----------------------------------------------------------------------------------
# Public PKCE client created by rmu-platform/terraform. The browser reaches Keycloak through the
# gateway under /sso, on the same origin as the shell (silent sign-in needs its session cookie).
RMU_IAM_URI=http://localhost/sso
RMU_IAM_REALM=rmu
RMU_IAM_CLIENT_ID=rmu-client-front

# --- Static assets -----------------------------------------------------------------------------
# Images and locales from the rmu-mfe-assets container (or `python3 local-start.py` on :4000).
RMU_MFE_ASSETS_URI=/mfe/assets/
# Base URL for the i18n locales. Defaults to RMU_MFE_ASSETS_URI.
# RMU_MFE_I18N_URI=/mfe/assets/

# --- Remote micro-frontends --------------------------------------------------------------------
# The trailing slash is required: the shell appends `<name>-app.js`. The gateway serves each one
# from its container, or from its dev server when the container is stopped.
RMU_MFE_CORE_PUBLIC_PATH=/mfe/core/
RMU_MFE_STRATEGIC_PUBLIC_PATH=/mfe/strategic/
RMU_MFE_TACTICAL_PUBLIC_PATH=/mfe/tactical/
RMU_MFE_NPCS_PUBLIC_PATH=/mfe/npcs/
RMU_MFE_ITEMS_PUBLIC_PATH=/mfe/items/
RMU_MFE_SPELLS_PUBLIC_PATH=/mfe/spells/

# --- APIs --------------------------------------------------------------------------------------
# Behind the gateway (/api/<name>/v1).
RMU_API_CORE_URI=/api/core/v1
RMU_API_STRATEGIC_URI=/api/strategic/v1
RMU_API_TACTICAL_URI=/api/tactical/v1
RMU_API_ATTACK_TABLES_URI=/api/attack-tables/v1
RMU_API_ITEMS_URI=/api/items/v1
RMU_API_NPC_NAMES_URI=/api/npc-names/v1
RMU_API_NPCS_URI=/api/npcs/v1
RMU_API_SPELLS_URI=/api/spells/v1
RMU_API_USERS_URI=/api/users/v1
RMU_API_MEDIA_URI=/api/media/v1

# --- Contact page (optional) -------------------------------------------------------------------
# RMU_SHELL_CONTACT_URI=
# RMU_SHELL_CONTACT_EMAIL=
