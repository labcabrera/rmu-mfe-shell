# Local development against the rmu-platform stack.
#
#   cd ../rmu-platform && docker compose --profile infrastructure --profile apis up -d
#   cp .env.example .env && make start
#
# webpack loads `.env.<mode>` first (for example `.env.development` or `.env.production`)
# and falls back to this `.env` for anything not set there.

# Shell dev server
PORT=8080
RMU_MFE_SHELL_PUBLIC_PATH=http://localhost:8080/

# Keycloak (rmu-platform compose) and the public PKCE client created by rmu-platform/terraform.
# The client must allow http://localhost:8080/* as redirect URI and web origin
# (terraform.tfvars.example allows http://localhost:*).
KC_URL=http://localhost:8090
KC_REALM=rmu
KC_CLIENT_ID=rmu-client-front

# Static assets: images and locales served by rmu-mfe-assets (`python3 local-start.py`).
RMU_MFE_ASSETS=http://localhost:4000/
# Base URL for i18n locales. Defaults to RMU_MFE_ASSETS.
# RMU_MFE_I18N_BASE_URL=http://localhost:4000/

# APIs (rmu-platform `apis` profile or `npm run start:dev` in each API repo).
RMU_API_USERS_URL=http://localhost:3010/v1
RMU_API_MEDIA_URL=http://localhost:3011/v1

# Remote micro-frontends (`npm run start:live` in each rmu-mfe-* repo).
# The trailing slash is required: the shell appends `<name>-app.js`.
RMU_MFE_CORE_PUBLIC_PATH=http://localhost:8089/
RMU_MFE_STRATEGIC_PUBLIC_PATH=http://localhost:8082/
# rmu-mfe-tactical takes its port from its own PORT variable; adjust if it differs.
RMU_MFE_TACTICAL_PUBLIC_PATH=http://localhost:8083/
RMU_MFE_NPCS_PUBLIC_PATH=http://localhost:8084/
RMU_MFE_ITEMS_PUBLIC_PATH=http://localhost:8088/
RMU_MFE_SPELLS_PUBLIC_PATH=http://localhost:8087/

# Contact page (optional).
# REACT_APP_CONTACT_API=
# REACT_APP_CONTACT_EMAIL=
